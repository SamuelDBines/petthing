# Local demo. Copy to .env.local. Do not put live secrets in this file.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brand (customer-facing). Override before domains are registered.
NEXT_PUBLIC_APP_NAME=Pawtraitry
NEXT_PUBLIC_SITE_DOMAIN=pawtraitry.com
NEXT_PUBLIC_SUPPORT_EMAIL=hello@pawtraitry.com
# Optional referral code prefix (default PAW)
REFERRAL_CODE_PREFIX=PAW

# Admin (Google OAuth on canonical ADMIN_URL; password login only when ADMIN_PASSWORD_LOGIN=true)
ADMIN_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_ALLOWED_EMAILS=samuelbines@gmail.com
ADMIN_PASSWORD_LOGIN=false
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRON_SECRET=
FILE_SIGNING_SECRET=
IP_HASH_SALT=
# Comma-separated CIDRs for trusted reverse proxies (default 10.0.0.0/8)
TRUSTED_PROXY_CIDRS=10.0.0.0/8
# When true, force noindex on every store/host (staging safety). Per-store go-live uses LIVE_STORES instead.
SITE_NOINDEX=
# Comma-separated store ids using live Stripe, Prodigi live, Meta ads, and supplier order emails (e.g. pawtraitry)
LIVE_STORES=
# Per-store support inboxes (default hello@pawtraitry.com via SUPPORT_EMAIL)
SUPPORT_EMAIL=hello@pawtraitry.com
SUPPORT_EMAIL_FIXMONGER=
SUPPORT_EMAIL_JINGLEFOLD=
SUPPORT_EMAIL_PAWTRAITRY=
MANUAL_REVIEW=true
MAX_DAILY_GEN_SPEND_GBP=25
ADMIN_EMAIL=

# Supplier inboxes (no Go Dropship / ArtInBulk API — cron emails CSV or draft)
GODROPSHIP_ORDERS_EMAIL=
ARTINBULK_ORDERS_EMAIL=

# Shop lifecycle thresholds (optional)
SHOP_PAID_STUCK_HOURS=6
SHOP_TRACKING_STUCK_DAYS=7
SHOP_AUTO_DELIVERED_DAYS=10
ABANDONED_CHECKOUT_MIN_HOURS=2
ABANDONED_CHECKOUT_MAX_HOURS=48

# DigitalOcean Managed Postgres. Leave all three blank to keep the local JSON store.
# DATABASE_URL is the transaction-mode pool. DATABASE_URL_DIRECT is the direct connection, for migrations only.
# DATABASE_CA_CERT is the PEM from "Download CA certificate", or the word system on Advanced Edition.
DATABASE_URL=
DATABASE_URL_DIRECT=
DATABASE_CA_CERT=

# Supabase is unused once DATABASE_URL is set, and will be removed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — leave blank locally to use demo checkout (no card, no shipping).
# Multi-store: LIVE_STORES use STRIPE_LIVE_* ; other stores use STRIPE_TEST_* (STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET still work as test fallbacks).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=

# fal.ai — Flux Kontext multi. Leave blank locally to paint placeholder portraits.
FAL_KEY=
FAL_MODEL_ID=fal-ai/flux-pro/kontext/multi
FAL_SAFETY_TOLERANCE=2
FAL_COST_USD_PER_IMAGE=0.04
# Public https URL for scripts/fal-smoke.ts (fal cannot fetch localhost)
FAL_SMOKE_IMAGE_URL=
USD_TO_GBP=0.78

# Transactional email — Relay Email (recommended: EMAIL_PROVIDER=relayemail) or Amazon SES
EMAIL_PROVIDER=relayemail
RELAYEMAIL_API_KEY=
# Optional API base (default https://relayemail.net)
RELAYEMAIL_API_BASE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=eu-west-2
EMAIL_FROM=
EMAIL_REPLY_TO=
# Per-store overrides, e.g. EMAIL_FROM_PAWTRAITRY=Pawtraitry <orders@pawtraitry.com>
# EMAIL_FROM_HELLO_PAWTRAITRY=Pawtraitry <hello@pawtraitry.com>
# EMAIL_REPLY_TO_PAWTRAITRY=hello@pawtraitry.com
SES_CONFIGURATION_SET=
# Comma-separated SNS topic ARNs allowed for /api/webhooks/ses (empty = allow all)
SES_SNS_TOPIC_ARNS=
# Staging: only samuelbines@gmail.com, @example.com, and EMAIL_TEST_SINK receive live mail (outbox always written)
EMAIL_STAGING_GATE=
EMAIL_STAGING_ALLOWLIST=
EMAIL_TEST_SINK=
# Optional legacy provider
RESEND_API_KEY=

# Prodigi — PRODIGI_API_KEY for LIVE_STORES (live API); PRODIGI_SANDBOX_API_KEY for test stores.
PRODIGI_API_KEY=
PRODIGI_SANDBOX_API_KEY=
PRODIGI_SKU_PUZZLE=JIGSAW-PUZZLE-252
# Jinglefold personalised (Prodigi catalogue SKUs)
PRODIGI_SKU_XMAS_PLAS_BAUB=
PRODIGI_SKU_XMAS_ALUM_SQ=
PRODIGI_SKU_XMAS_GLASS_SQ=
PRODIGI_SKU_XMAS_PORC_BAUB=
PRODIGI_SKU_XMAS_WOOD=
PRODIGI_SKU_XMAS_PLAS_BAUB_3=
PRODIGI_JINGLEFOLD_PRINT_AREA=default
# Printful (stocking)
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_VARIANT_PF_716=
# Content worker (admin queue iframe proxied at /api/admin/content-worker/admin)
CONTENT_WORKER_INTERNAL_URL=http://127.0.0.1:8080
CONTENT_WORKER_SECRET=
# Error tracking (optional)
SENTRY_DSN=
# Analytics (optional; CSP allows NEXT_PUBLIC_POSTHOG_HOST or eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Meta ads (per store; loaded only after marketing cookie consent)
# Pawtraitry example:
# META_PIXEL_ID_PAWTRAITRY=
# META_CAPI_TOKEN_PAWTRAITRY=
# META_TEST_EVENT_CODE=   # optional; enables CAPI on staging when set
# META_DOMAIN_VERIFICATION_PAWTRAITRY=   # optional meta tag content for domain verification
# Legacy single-store fallback for pawtraitry pixel id:
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
