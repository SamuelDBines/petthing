# Copy to content-worker/.env — never commit real secrets.

CONTENT_WORKER_SECRET=dev-change-me
CONTENT_WORKER_DRY_RUN=true
CONTENT_WORKER_DATA_DIR=.data/content-worker
CONTENT_WORKER_OUTPUT_DIR=.data/content-worker/output
CONTENT_REPO_ROOT=..
NEXT_PUBLIC_APP_URL=http://localhost:3000
CONTENT_STORE_NAME=Pawtraitry

# Main app Postgres (order lookup + assets). Leave blank for demo assets only.
DATABASE_URL=

# Dedicated DB for the worker queue (defaults to SQLite in DATA_DIR).
CONTENT_DATABASE_URL=

CONTENT_SCHEDULER_ENABLED=true
CONTENT_DAILY_PLAN_CRON=0 7 * * *
CONTENT_POLL_PLAN_CRON=0 10 * * 1
CONTENT_TIMEZONE=Europe/London

CONTENT_MAX_DAILY_AI_SPEND_GBP=5
CONTENT_LLM_COST_PER_1K_GBP=0.002
CONTENT_AUTO_APPROVE_PLATFORMS={}

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FAL_KEY=

# YouTube Shorts (OAuth refresh token for channel)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Reels (Graph API)
META_ACCESS_TOKEN=
META_IG_USER_ID=

# Pinterest API v5
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# TikTok Content Posting (draft / private until audit)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# X — paid API; off by default
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

RESEND_WEBHOOK_SECRET=

CONTENT_DEMO_BEFORE=public/examples/pet-before.jpg
CONTENT_DEMO_AFTER=public/examples/pet-after.jpg
