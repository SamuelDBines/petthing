# Copy to .env.local for local development (see LOCAL.md).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: loopback URL for signed /api/media links during cron (when public ingress is briefly unavailable)
# INTERNAL_APP_URL=http://127.0.0.1:3000

NEXT_PUBLIC_APP_NAME=Pawtraitry
NEXT_PUBLIC_SITE_DOMAIN=pawtraitry.co.uk
NEXT_PUBLIC_SUPPORT_EMAIL=hello@pawtraitry.co.uk
REFERRAL_CODE_PREFIX=PAW

# Local dev: Google OAuth and/or password login (E2E uses ADMIN_PASSWORD_LOGIN=true)
ADMIN_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=local-dev-auth-secret-change-me
ADMIN_ALLOWED_EMAILS=samuelbines@gmail.com
ADMIN_PASSWORD_LOGIN=true
ADMIN_PASSWORD=portrait-dev
ADMIN_SESSION_SECRET=local-dev-admin-session-secret-change-me
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Share admin session across *.dropship.store.bishop-co-tech.co.uk on staging:
# ADMIN_COOKIE_DOMAIN=.bishop-co-tech.co.uk
CRON_SECRET=local-dev-cron-secret
FILE_SIGNING_SECRET=local-dev-file-signing-secret
IP_HASH_SALT=local-dev-ip-salt
MANUAL_REVIEW=true
MAX_DAILY_GEN_SPEND_GBP=25
ADMIN_EMAIL=you@example.com

# Local files (JSON DB, uploads, outbox) — outside the repo so dev server does not reload on every order
# LOCAL_DATA_DIR=/tmp/pawtraitry-local

# Optional API rate limits (per IP). Raise for E2E / load testing.
# RATE_LIMIT_CHECKOUT_PER_HOUR=10
# RATE_LIMIT_ORDERS_PER_HOUR=12

# Docker Compose Postgres (make dev)
DATABASE_URL=postgresql://pawtraitry:pawtraitry@localhost:5432/pawtraitry
DATABASE_URL_DIRECT=postgresql://pawtraitry:pawtraitry@localhost:5432/pawtraitry
DATABASE_SSL_MODE=disable

# Content worker (shares Postgres when DATABASE_URL is set)
CONTENT_WORKER_SECRET=dev-change-me
CONTENT_DATABASE_URL=postgresql://pawtraitry:pawtraitry@localhost:5432/pawtraitry

# Stripe TEST mode — paste from https://dashboard.stripe.com/test/apikeys
# Webhook secret: run `docker compose --profile stripe up stripe-listener` and copy whsec_… from the container logs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Extra hostnames per store (JSON) for staging / multi-host ingress without code changes
# STORE_EXTRA_DOMAINS={"pawtraitry":["dropship.store.bishop-co-tech.co.uk"],"fixmonger":["fixmonger.dropship.store.bishop-co-tech.co.uk"],"jinglefold":["jinglefold.dropship.store.bishop-co-tech.co.uk"]}
# Or: STORE_EXTRA_DOMAINS_PAWTRAITRY=host1.example,host2.example

# Skip fal NSFW checks when FAL_KEY is unset (staging mock stack)
# MOCK_MODERATION=true

# Optional sandboxes (leave blank for placeholders / mocks)
FAL_KEY=
FAL_MODEL_ID=fal-ai/flux-pro/kontext/multi
FAL_COST_USD_PER_IMAGE=0.04
USD_TO_GBP=0.78

RESEND_API_KEY=
EMAIL_FROM=

PRODIGI_API_KEY=
PRODIGI_ENV=sandbox
PRODIGI_SKU_PUZZLE=JIGSAW-PUZZLE-252

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Demo checkout when Stripe is unset (local only)
ALLOW_DEMO_CHECKOUT=true
