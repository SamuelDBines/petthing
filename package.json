{
  "name": "pawtraitry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.ts",
    "migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "seed": "tsx scripts/seed.ts",
    "migrate:content": "tsx scripts/migrate-content-worker.ts",
    "db:setup": "npm run migrate && npm run migrate:content && npm run seed",
    "test:e2e": "playwright test --grep-invert @stripe",
    "test:e2e:stripe": "E2E_STRIPE=1 playwright test --grep @stripe",
    "test:e2e:all": "playwright test",
    "validate:go-live": "tsx scripts/validate-go-live.ts",
    "test:e2e:prod-404": "playwright test e2e/shop-404-status.spec.ts --config=playwright.prod.config.ts",
    "test:e2e:prod-shop": "playwright test e2e/shop-checkout-prod.spec.ts --config=playwright.prod.config.ts",
    "rebuild:rollups": "tsx scripts/rebuild-analytics-rollups.ts",
    "test:postgres": "tsx --test tests/shop-supplier-batch.postgres.test.ts tests/migrate-0014-wildframe.test.ts tests/migrate-0016-wildframe-portraits.test.ts tests/migrate.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1158.0",
    "@aws-sdk/client-sesv2": "^3.1158.0",
    "@sentry/nextjs": "^10.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "browser-image-compression": "^2.0.2",
    "drizzle-orm": "^0.45.4",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.2",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "sns-validator": "^0.3.5",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
