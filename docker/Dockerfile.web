# Production web image (used by k8s / GHCR builds).
# Do not bake NEXT_PUBLIC_SUPPORT_EMAIL or other tenant-specific values at build time —
# set SUPPORT_EMAIL_* / NEXT_PUBLIC_* on the Deployment from secrets or config.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
CMD ["npm", "run", "start"]
